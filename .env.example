# ============================================================
# RAG Doctor — Environment Configuration
# Copy this file to .env and fill in EVERY blank value.
# The app will refuse to start with a clear error message
# if any required variable is missing or empty.
# ============================================================

# ------ Nebius API credentials ---------------------------
# Your API key from https://studio.nebius.ai/settings/api-keys
NEBIUS_API_KEY=

# Base URL for the Nebius Token Factory OpenAI-compatible endpoint
# Example format: https://api.studio.nebius.ai/v1
NEBIUS_BASE_URL=

# ------ NVIDIA Nemotron model names ----------------------
# Fill from the Nebius Token Factory model catalog.
# All three tiers are required.

# Nano  — bulk work: answering exam questions, cheap classification
MODEL_NANO=

# Super — exam generation, query rewriting, drafting fixes
MODEL_SUPER=

# Ultra — judge, failure diagnosis, tuning decisions, contradiction analysis
MODEL_ULTRA=

# ------ Embedding model ----------------------------------
# Fill from the Nebius Token Factory model catalog.
# If this model is unavailable, the app will fall back to BM25-only
# retrieval and display a prominent warning in the UI.
EMBEDDING_MODEL=

# ------ Reranker model (optional) ------------------------
# Leave blank to skip the reranking step.
RERANK_MODEL=

# ------ Token prices (USD per 1 million tokens) ----------
# Fill from the Nebius pricing page for each model tier.
# Used to compute per-call and total-run cost displayed in the UI.
# Do NOT leave blank — the app will fail clearly if these are missing.

NANO_PRICE_IN=
NANO_PRICE_OUT=

SUPER_PRICE_IN=
SUPER_PRICE_OUT=

ULTRA_PRICE_IN=
ULTRA_PRICE_OUT=

# ------ Optional integrations (Stage 2) ------------------
# Leave blank to disable.
TAVILY_API_KEY=
